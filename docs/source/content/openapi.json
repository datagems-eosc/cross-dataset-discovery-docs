    "/search-ap/": {
      "post": {
        "description": "Same search as `POST /search/`, but the request and response are DataGEMS analytical patterns. The search arguments are read from the `properties` of the node labelled `CDD_Operator`. In the response, any nodes previously connected as outputs of the operator are removed; one `sc:Dataset` node is added per result dataset and one `cr:FileObject` node per result object, with an `output` edge from the operator and a `distribution` edge from the dataset to each object. The full search response is merged into the pattern's `metadata`. A pattern without a `CDD_Operator` node, without `query`, or with invalid optional arguments results in a 500 error.",
        "operationId": "perform_search_from_ap_search_ap__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticalPattern"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticalPattern"
                }
              }
            },
            "description": "The input analytical pattern, updated with the search results."
          },
          "400": {
            "content": {
