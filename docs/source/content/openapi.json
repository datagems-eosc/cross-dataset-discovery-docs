          "424": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailedDependencyResponse"
                }
              }
            },
            "description": "Failed Dependency - a downstream service (OIDC provider, Qdrant, TEI, or the search component itself) is unavailable or returned an error. The downstream status code is reported in `message.statusCode`."
